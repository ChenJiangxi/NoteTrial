# NoteTrial 环境配置

# OpenAI/OpenRouter API Key (必填)
# 推荐使用 OpenRouter，支持多种模型
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
# 或使用 OpenRouter:
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY="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"

# 默认使用的模型
DEFAULT_MODEL=gpt-4o

# 小红书 MCP 服务地址 (需要先启动 xiaohongshu-mcp)
XIAOHONGSHU_MCP_URL=http://localhost:18060/mcp

# 服务端口配置
BACKEND_PORT=8000
FRONTEND_PORT=3000

# 开发模式
DEBUG=true
